# ============================================================
# HomeGenie - Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git (it's in .gitignore).
# ============================================================
# Generate JWT_SECRET with: openssl rand -hex 32
# ============================================================

# ─── REQUIRED SECRETS (no defaults - must be set) ──────────
JWT_SECRET=<generate-with-openssl-rand-hex-32>
REDIS_PASSWORD=<your-redis-password>
ACTUATOR_PASSWORD=<your-actuator-password>

# ─── DATABASE ──────────────────────────────────────────────
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_USERNAME=postgres

# ─── STRIPE (Payment Service) ──────────────────────────────
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AWS (Notification + Maintenance Service) ──────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=no-reply@homegenie.com
AWS_S3_BUCKET_NAME=homegenie-uploads

# ─── EMAIL / SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_PROVIDER=smtp

# ─── KAFKA ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── SERVICE URLs (local dev  defaults) ─────────────────────
USER_SERVICE_URL=http://localhost:8081
MAINTENANCE_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# ─── FRONTEND (homegenie-app) ──────────────────────────────
VITE_GATEWAY_URL=http://localhost:8080
VITE_APP_NAME=HomeGenie
VITE_ENVIRONMENT=development
VITE_DEBUG_MODE=true
