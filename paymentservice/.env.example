# =====================================================
# HomeGenie Payment Service - Environment Variables
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homegenie_payments
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =====================================================
# STRIPE PAYMENT GATEWAY
# FREE Test Keys - Get yours at: https://stripe.com/
# Sign up for FREE account and get test keys from Dashboard
# =====================================================
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=usd

# =====================================================
# PAYMENT CONFIGURATION
# =====================================================
PAYMENT_MIN_AMOUNT=1.00
PAYMENT_MAX_AMOUNT=1000000.00
PAYMENT_AUTO_CAPTURE=true
PAYMENT_REFUND_DAYS=30

# =====================================================
# INVOICE CONFIGURATION
# =====================================================
INVOICE_NUMBER_PREFIX=INV
INVOICE_DUE_DAYS=7
INVOICE_LATE_FEE_PERCENTAGE=5.0

# =====================================================
# MICROSERVICES URLs
# =====================================================
USER_SERVICE_URL=http://localhost:8081
MAINTENANCE_SERVICE_URL=http://localhost:8082

# =====================================================
# MONITORING & OBSERVABILITY
# =====================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# =====================================================
# HOW TO GET STRIPE KEYS (FREE):
# =====================================================
# 1. Go to https://stripe.com/
# 2. Click "Start now" and sign up for FREE account
# 3. After login, go to: https://dashboard.stripe.com/test/apikeys
# 4. Copy "Secret key" (starts with sk_test_...) → STRIPE_API_KEY
# 5. Go to: https://dashboard.stripe.com/test/webhooks
# 6. Click "Add endpoint"
# 7. Set URL: http://localhost:8083/api/webhooks/stripe
# 8. Select events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# 9. Copy "Signing secret" (starts with whsec_...) → STRIPE_WEBHOOK_SECRET
#
# FREE TIER LIMITS:
# - Unlimited test transactions
# - No credit card needed for testing
# - Use test cards: 4242 4242 4242 4242 (any future date, any CVC)
# =====================================================
