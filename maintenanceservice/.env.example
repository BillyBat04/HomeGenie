# ===========================================
# MAINTENANCE SERVICE ENVIRONMENT VARIABLES
# ===========================================
# Copy file này thành .env và điền đầy đủ các giá trị thực

# ------------------
# DATABASE SETTINGS
# ------------------
# PostgreSQL database URL cho Maintenance Service
POSTGRES_URL=jdbc:postgresql://localhost:5432/homegenie_maintenance
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# -------------------
# JWT CONFIGURATION
# -------------------
# (Không cần thiết cho Maintenance Service - chỉ cần cho User Service)

# -------------------
# EMAIL SETTINGS
# -------------------
# Email provider: 'smtp' hoặc 'ses' (Amazon SES)
EMAIL_PROVIDER=smtp

# SMTP Configuration (nếu dùng Gmail hoặc SMTP server khác)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# Lưu ý: Gmail yêu cầu App Password, không dùng password thường
# Tạo App Password tại: https://myaccount.google.com/apppasswords

# Email addresses
SMTP_FROM_EMAIL=no-reply@homegenie.com
ADMIN_EMAIL=admin@homegenie.com

# -------------------
# AWS SETTINGS
# -------------------
# AWS Region (mặc định: us-east-1)
AWS_REGION=us-east-1

# AWS Credentials cho S3 và SES
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# S3 Bucket name cho upload ảnh
AWS_S3_BUCKET_NAME=homegenie-uploads-tushar

# AWS SES From Email (phải được verify trên AWS SES)
AWS_SES_FROM_EMAIL=no-reply@homegenie.com

# Local storage fallback (nếu AWS S3 không khả dụng)
LOCAL_STORAGE_PATH=./local_images
LOCAL_STORAGE_BASE_URL=http://localhost:8082/local/images

# -------------------
# AI SERVICES
# -------------------
# AI Provider: 'gemini' hoặc 'huggingface' hoặc 'rules'
AI_PROVIDER=gemini

# Gemini API Key (Google AI)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# HuggingFace API Token (dự phòng nếu Gemini fail)
# Lấy token tại: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=YOUR_HUGGINGFACE_API_TOKEN

# -------------------
# VOICE SERVICE
# -------------------
# URL của Python Voice Service
VOICE_SERVICE_URL=http://localhost:8000

# Voice Assistant Settings
VOICE_ASSISTANT_ENABLED=true
VOICE_ASSISTANT_TIMEOUT=30000
VOICE_ASSISTANT_MAX_RETRIES=3

# Voice Features
VOICE_FEATURES_AUTO_CLASSIFICATION=true
VOICE_FEATURES_EMERGENCY_DETECTION=true
VOICE_FEATURES_CONTEXT_AWARE=true

# -------------------
# MICROSERVICES URLS
# -------------------
# User Service URL
USER_SERVICE_URL=http://localhost:8081

# -------------------
# SERVER SETTINGS
# -------------------
SERVER_PORT=8082

# -------------------
# MONITORING
# -------------------
# Actuator endpoints exposure
MANAGEMENT_ENDPOINTS_EXPOSURE=health,info,prometheus,metrics
MANAGEMENT_PROMETHEUS_ENABLED=true

# -------------------
# LOGGING
# -------------------
LOGGING_LEVEL=DEBUG
