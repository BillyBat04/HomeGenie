# ===========================================
# PYTHON VOICE SERVICE ENVIRONMENT VARIABLES
# ===========================================
# Copy file này thành .env và điền đầy đủ các giá trị thực

# -------------------
# AI PROVIDER
# -------------------
# Chọn AI provider: 'gemini' hoặc 'huggingface'
AI_PROVIDER=gemini

# -------------------
# GEMINI API
# -------------------
# Gemini API Key (Google AI) - FREE TIER
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/minute, 1500 requests/day
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# -------------------
# HUGGINGFACE API
# -------------------
# HuggingFace API Token - FREE TIER với rate limit
# Lấy token tại: https://huggingface.co/settings/tokens
# Free tier: 30,000 characters/month
HUGGINGFACE_API_TOKEN=YOUR_HUGGINGFACE_API_TOKEN

# HuggingFace Model (mặc định: Mixtral-8x7B-Instruct)
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# -------------------
# SERVER SETTINGS
# -------------------
# Port của FastAPI service
PORT=8000

# -------------------
# AUDIO SETTINGS
# -------------------
# Audio conversion settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2

# -------------------
# SPEECH RECOGNITION
# -------------------
# Sử dụng Google Speech Recognition API (MIỄN PHÍ)
# Không cần API key cho free tier

# -------------------
# TEXT-TO-SPEECH
# -------------------
# Sử dụng gTTS (Google Text-to-Speech) - MIỄN PHÍ
# Language code (mặc định: en)
TTS_LANGUAGE=en
TTS_SLOW_SPEED=false

# -------------------
# LOGGING
# -------------------
LOG_LEVEL=INFO
