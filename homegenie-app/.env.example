# ===========================================
# REACT FRONTEND ENVIRONMENT VARIABLES
# ===========================================
# Copy file này thành .env và điền đầy đủ các giá trị thực
# Lưu ý: Vite sử dụng prefix VITE_ cho environment variables

# -------------------
# BACKEND SERVICE URLS
# -------------------
# User Service API URL
VITE_USER_SERVICE_URL=http://localhost:8081/api

# Maintenance Service API URL
VITE_MAINTENANCE_SERVICE_URL=http://localhost:8082/api

# -------------------
# FUTURE SERVICES (Planned)
# -------------------
# Payment Service API URL (chưa implement)
# VITE_PAYMENT_SERVICE_URL=http://localhost:8083/api

# Notification Service API URL (chưa implement)
# VITE_NOTIFICATION_SERVICE_URL=http://localhost:8084/api

# -------------------
# VOICE ASSISTANT
# -------------------
# Voice Service URL (Python FastAPI)
VITE_VOICE_SERVICE_URL=http://localhost:8000

# -------------------
# APP SETTINGS
# -------------------
# App name
VITE_APP_NAME=HomeGenie

# Environment: development, staging, production
VITE_ENVIRONMENT=development

# Enable debug mode
VITE_DEBUG_MODE=true
