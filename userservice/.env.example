# ===========================================
# USER SERVICE ENVIRONMENT VARIABLES
# ===========================================
# Copy file này thành .env và điền đầy đủ các giá trị thực

# ------------------
# DATABASE SETTINGS
# ------------------
# PostgreSQL database URL cho User Service
POSTGRES_URL=jdbc:postgresql://localhost:5432/homegenie_users
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# -------------------
# JWT CONFIGURATION
# -------------------
# JWT Secret Key - PHẢI thay đổi trong production
# Tạo secret key mạnh bằng lệnh: openssl rand -base64 64
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_AT_LEAST_256_BITS_LONG_PLEASE_CHANGE_THIS_IN_PRODUCTION

# JWT Token expiration time in milliseconds
# 86400000 = 24 hours
# 3600000 = 1 hour
JWT_EXPIRATION=86400000

# -------------------
# SERVER SETTINGS
# -------------------
SERVER_PORT=8081

# -------------------
# LOGGING
# -------------------
LOGGING_LEVEL=DEBUG
