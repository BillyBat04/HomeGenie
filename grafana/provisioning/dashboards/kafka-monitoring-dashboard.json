{
    "uid": "homegenie-kafka-monitoring",
    "title": "HomeGenie - Kafka Monitoring",
    "tags": [
        "homegenie",
        "kafka",
        "messaging"
    ],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Payment Events Lag",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(kafka_consumergroup_lag{topic=\"payment-completed\"})",
                    "legendFormat": "Lag",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 100,
                                "color": "yellow"
                            },
                            {
                                "value": 500,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Maintenance Events Lag",
            "gridPos": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(kafka_consumergroup_lag{topic=\"maintenance-reminder\"})",
                    "legendFormat": "Lag",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 100,
                                "color": "yellow"
                            },
                            {
                                "value": 500,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Warranty Events Lag",
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(kafka_consumergroup_lag{topic=\"warranty-reminder\"})",
                    "legendFormat": "Lag",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 100,
                                "color": "yellow"
                            },
                            {
                                "value": 500,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Email Notification Lag",
            "gridPos": {
                "x": 18,
                "y": 0,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(kafka_consumergroup_lag{topic=\"email-notification\"})",
                    "legendFormat": "Lag",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 100,
                                "color": "yellow"
                            },
                            {
                                "value": 500,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Consumer Lag by Topic",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 24,
                "h": 8
            },
            "targets": [
                {
                    "expr": "kafka_consumergroup_lag{topic=\"payment-completed\"}",
                    "legendFormat": "Payment Events - Partition {{partition}}",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "kafka_consumergroup_lag{topic=\"maintenance-reminder\"}",
                    "legendFormat": "Maintenance Events - Partition {{partition}}",
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "kafka_consumergroup_lag{topic=\"warranty-reminder\"}",
                    "legendFormat": "Warranty Events - Partition {{partition}}",
                    "refId": "C",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "kafka_consumergroup_lag{topic=\"email-notification\"}",
                    "legendFormat": "Email Notification - Partition {{partition}}",
                    "refId": "D",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "fillOpacity": 10
                    }
                }
            }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Message Processing Rate",
            "gridPos": {
                "x": 0,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(kafka_consumer_records_consumed_total{topic=\"payment-completed\"}[5m])",
                    "legendFormat": "Payment Events",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "rate(kafka_consumer_records_consumed_total{topic=\"maintenance-reminder\"}[5m])",
                    "legendFormat": "Maintenance Events",
                    "refId": "B",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "rate(kafka_consumer_records_consumed_total{topic=\"warranty-reminder\"}[5m])",
                    "legendFormat": "Warranty Events",
                    "refId": "C",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                },
                {
                    "expr": "rate(kafka_consumer_records_consumed_total{topic=\"email-notification\"}[5m])",
                    "legendFormat": "Email Notification",
                    "refId": "D",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    }
                }
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Failed Message Processing",
            "gridPos": {
                "x": 12,
                "y": 12,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(spring_kafka_listener_seconds_count{result=\"failure\"}[5m])",
                    "legendFormat": "Failed - {{topic}}",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    }
                }
            }
        },
        {
            "id": 8,
            "type": "bargauge",
            "title": "Consumer Group Lag Status",
            "gridPos": {
                "x": 0,
                "y": 20,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "sum by (topic) (kafka_consumergroup_lag)",
                    "legendFormat": "{{topic}}",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "options": {
                "orientation": "horizontal",
                "displayMode": "gradient",
                "showUnfilled": true
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 100,
                                "color": "yellow"
                            },
                            {
                                "value": 500,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 9,
            "type": "table",
            "title": "Partition Distribution",
            "gridPos": {
                "x": 12,
                "y": 20,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "kafka_consumergroup_lag",
                    "legendFormat": "",
                    "refId": "A",
                    "format": "table",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "options": {
                "showHeader": true
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "left"
                    }
                }
            }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Kafka Consumer Commit Rate",
            "gridPos": {
                "x": 0,
                "y": 28,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "expr": "rate(kafka_consumer_commit_total[5m])",
                    "legendFormat": "{{consumergroup}} - {{topic}}",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth"
                    }
                }
            }
        },
        {
            "id": 11,
            "type": "stat",
            "title": "Total Messages in Queue",
            "gridPos": {
                "x": 12,
                "y": 28,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "sum(kafka_consumergroup_lag)",
                    "legendFormat": "Total Lag",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 500,
                                "color": "yellow"
                            },
                            {
                                "value": 2000,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 12,
            "type": "stat",
            "title": "Active Consumer Groups",
            "gridPos": {
                "x": 18,
                "y": 28,
                "w": 6,
                "h": 4
            },
            "targets": [
                {
                    "expr": "count(count by (consumergroup) (kafka_consumergroup_lag))",
                    "legendFormat": "Groups",
                    "refId": "A",
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": {
                        "mode": "palette-classic"
                    }
                }
            }
        }
    ]
}
