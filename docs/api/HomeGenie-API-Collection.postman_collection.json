{
    "info": {
        "name": "HomeGenie API Collection",
        "_postman_id": "homegenie-api-v1",
        "description": "Complete API collection for HomeGenie microservices (User, Maintenance, Payment, Notification)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url_user",
            "value": "http://localhost:8081",
            "type": "string"
        },
        {
            "key": "base_url_maintenance",
            "value": "http://localhost:8082",
            "type": "string"
        },
        {
            "key": "base_url_payment",
            "value": "http://localhost:8083",
            "type": "string"
        },
        {
            "key": "base_url_notification",
            "value": "http://localhost:8084",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "user_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "maintenance_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "wallet_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "payment_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. User Service",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"user_id\", jsonData.userId);",
                                    "",
                                    "pm.test(\"Registration successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(jsonData.message).to.include(\"successfully\");",
                                    "    pm.expect(jsonData.userId).to.exist;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fullName\": \"Nguyễn Văn An\",\n  \"email\": \"nguyenvana@example.com\",\n  \"phoneNumber\": \"0901234567\",\n  \"password\": \"SecurePass123!\",\n  \"address\": \"123 Đường ABC, Quận 1, TP.HCM\",\n  \"role\": \"RESIDENT\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url_user}}/api/users/register",
                            "host": [
                                "{{base_url_user}}"
                            ],
                            "path": [
                                "api",
                                "users",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "",
                                    "// Save JWT token and user ID",
                                    "pm.environment.set(\"jwt_token\", jsonData.token);",
                                    "pm.environment.set(\"user_id\", jsonData.userId);",
                                    "",
                                    "console.log(\"JWT Token:\", jsonData.token);",
                                    "console.log(\"User ID:\", jsonData.userId);",
                                    "",
                                    "pm.test(\"Login successful\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(jsonData.token).to.exist;",
                                    "    pm.expect(jsonData.userId).to.exist;",
                                    "    pm.expect(jsonData.role).to.exist;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"nguyenvana@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url_user}}/api/users/login",
                            "host": [
                                "{{base_url_user}}"
                            ],
                            "path": [
                                "api",
                                "users",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Maintenance Service",
            "item": [
                {
                    "name": "Create Maintenance Request",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"maintenance_id\", jsonData.id);",
                                    "",
                                    "pm.test(\"Request created with AI classification\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(jsonData.id).to.exist;",
                                    "    pm.expect(jsonData.category).to.exist;",
                                    "    pm.expect(jsonData.priority).to.exist;",
                                    "    pm.expect(jsonData.status).to.equal(\"PENDING\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Điều hòa hỏng không lạnh\",\n  \"description\": \"Điều hòa phòng ngủ không lạnh, có tiếng ồn lớn. Cần sửa gấp!\",\n  \"location\": \"Căn hộ A-101, Tầng 1, Tòa A\",\n  \"imageBase64\": \"\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/create",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "create"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Request by ID",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/{{maintenance_id}}",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "{{maintenance_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get User Requests",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/user/{{user_id}}",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "user",
                                "{{user_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Assign Technician",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"technicianId\": 5,\n  \"estimatedCost\": 500000.00,\n  \"notes\": \"Cần thay gas điều hòa\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/{{maintenance_id}}/assign",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "{{maintenance_id}}",
                                "assign"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Status",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"notes\": \"Đang kiểm tra điều hòa\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/{{maintenance_id}}/status",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "{{maintenance_id}}",
                                "status"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Categories",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/categories",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "categories"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Technicians",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url_maintenance}}/api/maintenance/technicians",
                            "host": [
                                "{{base_url_maintenance}}"
                            ],
                            "path": [
                                "api",
                                "maintenance",
                                "technicians"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Payment Service",
            "item": [
                {
                    "name": "Wallet Operations",
                    "item": [
                        {
                            "name": "Create Wallet",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "var jsonData = pm.response.json();",
                                            "pm.environment.set(\"wallet_id\", jsonData.id);",
                                            "",
                                            "pm.test(\"Wallet created\", function () {",
                                            "    pm.response.to.have.status(200);",
                                            "    pm.expect(jsonData.id).to.exist;",
                                            "    pm.expect(jsonData.balance).to.equal(0);",
                                            "});"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"userId\": {{user_id}},\n  \"initialBalance\": 0.0\n}"
                                },
                                "url": {
                                    "raw": "{{base_url_payment}}/api/payments/wallets/create",
                                    "host": [
                                        "{{base_url_payment}}"
                                    ],
                                    "path": [
                                        "api",
                                        "payments",
                                        "wallets",
                                        "create"
                                    ]
                                }
                            }
                        },
                        {
                            "name": "Get Wallet",
