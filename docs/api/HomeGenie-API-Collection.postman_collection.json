                            "request": {
                                "method": "GET",
                                "url": {
                                    "raw": "{{base_url_payment}}/api/payments/wallets/{{wallet_id}}/balance",
                                    "host": [
                                        "{{base_url_payment}}"
                                    ],
                                    "path": [
                                        "api",
                                        "payments",
                                        "wallets",
                                        "{{wallet_id}}",
                                        "balance"
                                    ]
                                }
                            }
                        },
                        {
                            "name": "Get Transactions",
                            "request": {
                                "method": "GET",
                                "url": {
                                    "raw": "{{base_url_payment}}/api/payments/wallets/{{wallet_id}}/transactions",
