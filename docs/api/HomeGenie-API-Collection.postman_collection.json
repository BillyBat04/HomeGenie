                                    "path": [
                                        "api",
                                        "payments",
                                        "wallets",
                                        "{{wallet_id}}",
                                        "transactions"
                                    ]
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "Payment Operations",
                    "item": [
                        {
                            "name": "Create Payment",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "var jsonData = pm.response.json();",
                                            "pm.environment.set(\"payment_id\", jsonData.id);"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n  \"userId\": {{user_id}},\n  \"maintenanceRequestId\": {{maintenance_id}},\n  \"amount\": 500000.00,\n  \"description\": \"Sửa điều hòa\",\n  \"paymentMethod\": \"WALLET\"\n}"
                                },
                                "url": {
                                    "raw": "{{base_url_payment}}/api/payments/create",
                                    "host": [
