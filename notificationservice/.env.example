# =====================================================
# Notification Service Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homegenie_notifications
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Email Configuration - SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Email Configuration - AWS SES (Production)
AWS_SES_ACCESS_KEY=your_aws_access_key
AWS_SES_SECRET_KEY=your_aws_secret_key
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@homegenie.com

# SMS Configuration - AWS SNS (Optional)
AWS_SNS_ACCESS_KEY=your_aws_access_key
AWS_SNS_SECRET_KEY=your_aws_secret_key
AWS_SNS_REGION=us-east-1

# Microservices URLs
USER_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8083
MAINTENANCE_SERVICE_URL=http://localhost:8082

# Notification Settings
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_RETENTION_DAYS=90

# Email Provider (smtp or ses)
EMAIL_PROVIDER=smtp

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_HOMEGENIE=DEBUG

# =====================================================
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords
# 4. Generate password for "Mail"
# 5. Copy 16-character password to SMTP_PASSWORD
# =====================================================

# =====================================================
# How to get AWS SES Credentials:
# 1. Login to AWS Console
# 2. Go to IAM → Users → Create User
# 3. Attach AmazonSESFullAccess policy
# 4. Create Access Key
# 5. Copy Access Key ID and Secret Key
# 6. Verify email in SES console
# =====================================================
